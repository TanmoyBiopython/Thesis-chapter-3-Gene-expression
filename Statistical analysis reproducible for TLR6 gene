# Load required libraries
library(dunn.test)

# ---- Data (TLR6) ----
gbs <- c(1.43, 0.32, 1.69, 19.36, 0.19, 0.35, 2.02, 2.15, 97.46, 0.19,
         0.34, 0.79, 34.63, 7.15, 1.02, 2.98, 2.39, 4.67, 0.35, 1.32,
         0.50, 0.58, 2.00)

sle <- c(2.82, 1.24, 0.20, 1.16, 2.38, 5.55, 0.57, 0.76, 0.56, 2.98,
         1.39, 3.39, 0.80, 2.87, 2.06, 0.55, 6.77, 1.72, 5.76, 2.08,
         9.58, 2.79, 41.32)

ms <- c(1.73, 10.38, 10.93, 9.74, 1.97, 2.46, 0.18, 1.69, 1.48, 9.79,
        3.80, 1.65, 5.36, 2.32, 2.37, 0.51, 9.03, 5.32, 0.36, 11.57,
        1.03, 2.25, 3.98)

hc_ddct <- c(-0.51, 1.69, 0.04, 0.75, 2.47, 2.35, -0.52, 0.78, -0.47,
             3.62, -2.19, -6.21, -1.92, -4.75, 0.21, -0.23, -0.67, -0.85,
             0.80, 0.81, 0.69, 0.75, 3.36)

# ---- Helper function for descriptive stats ----
desc_stats <- function(x) {
  c(n = length(x),
    Mean = mean(x),
    Median = median(x),
    Q1 = quantile(x, 0.25),
    Q3 = quantile(x, 0.75),
    Min = min(x),
    Max = max(x),
    SD = sd(x))
}

# ==========================================
# 1. Top Left: Descriptive summary (FC)
# ==========================================
cat("\n--- Descriptive summary — TLR6 fold change ---\n")
fc_table <- data.frame(
  Group = c("GBS", "SLE", "MS", "HC QC"),
  n = c(23, 23, 23, 23),
  Mean_FC = c(round(mean(gbs),2), round(mean(sle),2), round(mean(ms),2), "ΔΔCt mean ≈ -0.59"),
  Median_FC = c(round(median(gbs),2), round(median(sle),2), round(median(ms),2), "ΔΔCt median = 0.04"),
  IQR = c("0.35–2.98", "0.80–3.39", "1.65–9.03", "-0.67–0.81"),
  Min = c(round(min(gbs),2), round(min(sle),2), round(min(ms),2), round(min(hc_ddct),2)),
  Max = c(round(max(gbs),2), round(max(sle),2), round(max(ms),2), round(max(hc_ddct),2)),
  SD = c(round(sd(gbs),2), round(sd(sle),2), round(sd(ms),2), round(sd(hc_ddct),2))
)
print(fc_table)

# ==========================================
# 2. Kruskal-Wallis
# ==========================================
# Transform all to log2 scale (HC: log2FC = -ddCt)
values <- c(log2(gbs), log2(sle), log2(ms), -hc_ddct)
group  <- factor(rep(c("GBS", "SLE", "MS", "HC"), each = 23))

kw <- kruskal.test(values ~ group)
cat("\n--- Kruskal-Wallis results ---\n")
cat("H =", round(kw$statistic, 2), "\n")
cat("df =", kw$parameter, "\n")
cat("p ≈", format.pval(kw$p.value, digits = 2), "\n")

# ==========================================
# 3. Dunn post-hoc tests (Holm)
# ==========================================
cat("\n--- Dunn post-hoc tests (Holm-adjusted) ---\n")
dunn_res <- dunn.test(values, group, method = "holm", kw = FALSE)

# Extract and format Dunn results
dunn_df <- data.frame(
  Comparison = dunn_res$comparisons,
  z = round(dunn_res$Z, 2),
  Raw_p = format.pval(dunn_res$P, digits = 2),
  Holm_adj_p = format.pval(dunn_res$P.adjusted, digits = 2)
)
print(dunn_df)

# ==========================================
# 4. Bottom: Descriptive summary on log2 scale
# ==========================================
cat("\n--- 1. Descriptive summary on log2 scale ---\n")
log2_table <- data.frame(
  Group = c("GBS", "SLE", "MS", "HC QC"),
  n = c(23, 23, 23, 23),
  Median_log2_FC = c(round(log2(median(gbs)),2), round(log2(median(sle)),2), round(log2(median(ms)),2), round(-median(hc_ddct),2)),
  IQR_log2_FC = c(
    paste0(round(log2(quantile(gbs, 0.25)),2), " to ", round(log2(quantile(gbs, 0.75)),2)),
    paste0(round(log2(quantile(sle, 0.25)),2), " to ", round(log2(quantile(sle, 0.75)),2)),
    paste0(round(log2(quantile(ms, 0.25)),2), " to ", round(log2(quantile(ms, 0.75)),2)),
    paste0(round(-quantile(hc_ddct, 0.75),2), " to ", round(-quantile(hc_ddct, 0.25),2))
  ),
  Median_FC = c(round(median(gbs),2), round(median(sle),2), round(median(ms),2), round(2^(-median(hc_ddct)),2)),
  IQR_FC = c(
    paste0(round(quantile(gbs, 0.25),2), " to ", round(quantile(gbs, 0.75),2)),
    paste0(round(quantile(sle, 0.25),2), " to ", round(quantile(sle, 0.75),2)),
    paste0(round(quantile(ms, 0.25),2), " to ", round(quantile(ms, 0.75),2)),
    paste0(round(2^(-quantile(hc_ddct, 0.75)),2), " to ", round(2^(-quantile(hc_ddct, 0.25)),2))
  )
)
print(log2_table)
