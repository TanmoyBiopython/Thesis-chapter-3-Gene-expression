library(dunn.test)

# GBS
gbs <- c(1.93, 0.87, 1.65, 1.97, 1.50, 4.22, 4.38, 2.66, 1.60, 0.91,
         1.19, 4.16, 1.93, 0.67, 1.75, 2.46, 9.07, 4.02, 0.57, 1.94,
         1.35, 2.07, 2.64)

# SLE
sle <- c(6.95, 2.82, 0.81, 3.95, 4.53, 9.37, 1.94, 4.08, 2.55, 3.65,
         1.37, 4.90, 1.89, 15.33, 0.81, 2.43, 4.12, 5.78, 6.89, 2.69,
         11.31, 4.54, 0.37)

# MS
ms <- c(1.21, 14.16, 14.92, 17.14, 3.64, 3.61, 1.17, 3.66, 1.12, 24.34,
        0.28, 3.24, 14.18, 8.86, 5.75, 5.22, 5.62, 6.92, 0.79, 35.76,
        2.87, 4.77, 3.00)

# HC QC: DeltaDeltaCt -> log2 FC = -DeltaDeltaCt
hc_ddct <- c(-1.81, -0.17, -0.74, 0.39, 0.58, 0.75, -1.09, 1.05, 0.75,
             -1.40, 3.63, -0.91, 3.33, 2.75, -0.82, -1.31, -1.05, -1.69,
             -1.78, -0.99, -0.98, -0.37, 1.89)
hc <- -hc_ddct

# log2 transform
gbs_log2 <- log2(gbs)
sle_log2 <- log2(sle)
ms_log2  <- log2(ms)

# Combine
values <- c(gbs_log2, sle_log2, ms_log2, hc)
group  <- factor(rep(c("GBS", "SLE", "MS", "HC"), each = 23))

# Kruskal-Wallis
kruskal.test(values ~ group)

# Dunn post-hoc with Holm adjustment
dunn.test(values, group, method = "holm")

# If you want only GBS/SLE/MS:
values3 <- c(gbs_log2, sle_log2, ms_log2)
group3  <- factor(rep(c("GBS", "SLE", "MS"), each = 23))
kruskal.test(values3 ~ group3)
dunn.test(values3, group3, method = "holm")
