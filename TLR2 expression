  geom_point(data = d, aes(x = x, y = log2fc, colour = group), size = 1.9, alpha = 0.85) +
  # IQR whiskers with caps, then median line
  geom_segment(data = summ, aes(x = xpos, xend = xpos, y = q1, yend = q3), linewidth = 0.4) +
  geom_segment(data = summ, aes(x = xpos - 0.10, xend = xpos + 0.10, y = q1, yend = q1), linewidth = 0.4) +
  geom_segment(data = summ, aes(x = xpos - 0.10, xend = xpos + 0.10, y = q3, yend = q3), linewidth = 0.4) +
  geom_segment(data = summ, aes(x = xpos - 0.30, xend = xpos + 0.30, y = med, yend = med), linewidth = 0.8) +
  # significance brackets (Dunn, Holm-adjusted)
  geom_segment(data = sig, aes(x = xmin, xend = xmax, y = y, yend = y), linewidth = 0.4) +
  geom_segment(data = sig, aes(x = xmin, xend = xmin, y = y - 0.12, yend = y), linewidth = 0.4) +
  geom_segment(data = sig, aes(x = xmax, xend = xmax, y = y - 0.12, yend = y), linewidth = 0.4) +
  geom_text(data = sig, aes(x = (xmin + xmax) / 2, y = y + 0.08, label = label),
            vjust = 0, size = 2.8) +
  # Kruskal-Wallis label
  annotate("text", x = 0.5, y = 9.5, hjust = 0, vjust = 1, size = 2.8, lineheight = 0.95,
           label = paste0("Kruskal\u2013Wallis\n", fmt_p(kw_p))) +
