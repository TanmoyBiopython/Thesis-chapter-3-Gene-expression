# Dunn's test with tie correction and Holm adjustment (base R only)
dunn_holm <- function(x, g) {
  g  <- factor(g)
  N  <- length(x)
  r  <- rank(x)
  mr <- sapply(split(r, g), mean)
  n  <- sapply(split(r, g), length)
  tt  <- table(x)
  tie <- 1 - sum(tt^3 - tt) / (N^3 - N)
  pr  <- combn(levels(g), 2)
  res <- data.frame(a = pr[1, ], b = pr[2, ], stringsAsFactors = FALSE)
  res$z <- (mr[res$a] - mr[res$b]) /
    sqrt(N * (N + 1) / 12 * tie * (1 / n[res$a] + 1 / n[res$b]))
  res$p      <- 2 * pnorm(-abs(res$z))
  res$p_holm <- p.adjust(res$p, method = "holm")
  res
}
dunn <- dunn_holm(d$fc, d$group)
print(dunn)   # MS vs HC 7.0e-05, SLE vs HC 0.0011, MS vs GBS 0.0166 (Holm)

# brackets for every Holm-significant pair (shortest span lowest)
stars  <- function(p) if (p < 0.001) "***" else if (p < 0.01) "**" else "*"
fmt_p  <- function(p) if (p < 0.001) "p < 0.001" else sprintf("p = %.3f", p)
sig <- dunn[dunn$p_holm < 0.05, ]
sig$x1   <- match(sig$a, group_order)
sig$x2   <- match(sig$b, group_order)
sig$xmin <- pmin(sig$x1, sig$x2)
sig$xmax <- pmax(sig$x1, sig$x2)
sig <- sig[order(sig$xmax - sig$xmin, sig$xmin), ]
base_y <- 5.9; step_y <- 0.85
sig$y     <- base_y + (seq_len(nrow(sig)) - 1) * step_y
sig$label <- paste(sapply(sig$p_holm, stars), sapply(sig$p_holm, fmt_p))

# median and IQR on the log2 scale (R default quantile type 7)
summ <- do.call(rbind, lapply(group_order, function(g) {
  y <- d$log2fc[d$group == g]
  q <- quantile(y, c(0.25, 0.5, 0.75))
  data.frame(group = g, xpos = match(g, group_order),
             q1 = q[[1]], med = q[[2]], q3 = q[[3]], n = length(y))
}))

cols <- c(HC = "#2CA02C", GBS = "#1F77B4", MS = "#FF7F0E", SLE = "#D62728")

# ---- 3. Plot ------------------------------------------------------
ticks <- seq(-4, 8, by = 2)

p <- ggplot() +
