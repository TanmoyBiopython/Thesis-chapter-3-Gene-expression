names(d) <- c("group", "sample", "fc", "jitter")
d$fc     <- as.numeric(d$fc)
d$jitter <- as.numeric(d$jitter)

group_order <- c("HC", "GBS", "MS", "SLE")
d$group <- factor(d$group, levels = group_order)
d$x     <- as.numeric(d$group) + d$jitter
d$log2fc <- log2(d$fc)
d$flagged <- d$sample == "HC-33"      # QC-flagged outlier (outlying replicate well)

# ---- 2. Statistics ------------------------------------------------
kw   <- kruskal.test(fc ~ group, data = d)
kw_p <- kw$p.value                    # 0.1647 (H = 5.098, df = 3)
print(kw)

# median and IQR on the log2 scale (R default quantile type 7)
summ <- do.call(rbind, lapply(group_order, function(g) {
  y <- d$log2fc[d$group == g]
  q <- quantile(y, c(0.25, 0.5, 0.75))
  data.frame(group = g, xpos = match(g, group_order),
             q1 = q[[1]], med = q[[2]], q3 = q[[3]], n = length(y))
}))

cols <- c(HC = "#2CA02C", GBS = "#1F77B4", MS = "#FF7F0E", SLE = "#D62728")

# ---- 3. Plot ------------------------------------------------------
ticks <- seq(-6, 8, by = 2)

p <- ggplot() +
  geom_hline(yintercept = 0, linetype = "dashed", colour = "grey50", linewidth = 0.4) +
  # individual samples (filled), HC-33 shown as an open circle
  geom_point(data = d[!d$flagged, ], aes(x = x, y = log2fc, colour = group),
             size = 1.9, alpha = 0.85) +
  geom_point(data = d[d$flagged, ], aes(x = x, y = log2fc),
             shape = 1, size = 2.8, stroke = 0.7, colour = cols[["HC"]]) +
  annotate("text", x = d$x[d$flagged] + 0.17, y = d$log2fc[d$flagged],
           label = "HC-33\n(QC-flagged)", hjust = 0, size = 2.5, lineheight = 0.9) +
  # IQR whiskers with caps, then median line
  geom_segment(data = summ, aes(x = xpos, xend = xpos, y = q1, yend = q3), linewidth = 0.4) +
  geom_segment(data = summ, aes(x = xpos - 0.10, xend = xpos + 0.10, y = q1, yend = q1), linewidth = 0.4) +
  geom_segment(data = summ, aes(x = xpos - 0.10, xend = xpos + 0.10, y = q3, yend = q3), linewidth = 0.4) +
  geom_segment(data = summ, aes(x = xpos - 0.30, xend = xpos + 0.30, y = med, yend = med), linewidth = 0.8) +
  # Kruskal-Wallis label
  annotate("text", x = 3.55, y = 9.15, hjust = 1, vjust = 1, size = 2.8, lineheight = 0.95,
           label = sprintf("Kruskal\u2013Wallis\np = %.3f", kw_p)) +
  scale_colour_manual(values = cols, guide = "none") +
  scale_x_continuous(breaks = 1:4, limits = c(0.4, 4.6),
                     labels = paste0(group_order, "\n(n = ", summ$n, ")"),
                     expand = c(0, 0)) +
  scale_y_continuous(
    name   = expression("BAFFR relative expression (log"[2]*" fold change)"),
    breaks = ticks, limits = c(-6.8, 9.3), expand = c(0, 0),
    sec.axis = sec_axis(~ ., name = "Fold change", breaks = ticks,
                        labels = c("1/64", "1/16", "1/4", "1", "4", "16", "64", "256"))
  ) +
  labs(x = NULL) +
  theme_classic(base_size = 9, base_family = "sans") +
  theme(axis.text  = element_text(colour = "black"),
        axis.line  = element_line(linewidth = 0.4),
        axis.ticks = element_line(linewidth = 0.4),
        axis.line.x.top = element_blank())

print(p)

