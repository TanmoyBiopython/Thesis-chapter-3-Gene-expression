# Optional Dunn-Holm table for reference.
dunn_holm <- function(x, g) {
  g <- factor(g)
  N <- length(x)
  r <- rank(x)
  mr <- sapply(split(r, g), mean)
  n <- sapply(split(r, g), length)
  tt <- table(x)
  tie <- 1 - sum(tt^3 - tt) / (N^3 - N)
  pairs <- combn(levels(g), 2)
  out <- data.frame(group1 = pairs[1, ], group2 = pairs[2, ])
  out$z <- (mr[out$group1] - mr[out$group2]) /
    sqrt(N * (N + 1) / 12 * tie *
           (1 / n[out$group1] + 1 / n[out$group2]))
  out$p <- 2 * pnorm(-abs(out$z))
  out$p_holm <- p.adjust(out$p, method = "holm")
  out
}

print(dunn_holm(d$fc, d$group))

# ---- 3. Summary statistics for plot -------------------------------
summ <- do.call(rbind, lapply(group_order, function(g) {
  y <- d$log2fc[d$group == g]
  q <- quantile(y, c(0.25, 0.50, 0.75), names = FALSE)
  data.frame(group = g, xpos = match(g, group_order),
             q1 = q[1], med = q[2], q3 = q[3], n = length(y))
}))

# ---- 4. Plot ------------------------------------------------------
cols <- c(HC = "#2CA02C", GBS = "#1F77B4", MS = "#FF7F0E", SLE = "#D62728")
y_min <- floor(min(d$log2fc, na.rm = TRUE) - 1)
y_max <- ceiling(max(d$log2fc, na.rm = TRUE) + 1)
ticks <- seq(y_min, y_max, by = 2)

fmt_p <- function(p) {
  if (p < 0.001) "p < 0.001" else sprintf("p = %.3f", p)
}

p <- ggplot(d, aes(x = x, y = log2fc, colour = group)) +
  geom_hline(yintercept = 0, linetype = "dashed", colour = "grey50", linewidth = 0.4) +
  geom_point(size = 1.9, alpha = 0.85) +
  geom_segment(data = summ,
               aes(x = xpos, xend = xpos, y = q1, yend = q3),
               inherit.aes = FALSE, linewidth = 0.4, colour = "black") +
  geom_segment(data = summ,
               aes(x = xpos - 0.10, xend = xpos + 0.10, y = q1, yend = q1),
               inherit.aes = FALSE, linewidth = 0.4, colour = "black") +
  geom_segment(data = summ,
               aes(x = xpos - 0.10, xend = xpos + 0.10, y = q3, yend = q3),
               inherit.aes = FALSE, linewidth = 0.4, colour = "black") +
  geom_segment(data = summ,
               aes(x = xpos - 0.30, xend = xpos + 0.30, y = med, yend = med),
               inherit.aes = FALSE, linewidth = 0.8, colour = "black") +
  annotate("text", x = 0.5, y = y_max - 0.1, hjust = 0, vjust = 1,
           size = 2.8, lineheight = 0.95,
           label = paste0("Kruskal–Wallis\n", fmt_p(kw$p.value))) +
  scale_colour_manual(values = cols, guide = "none") +
  scale_x_continuous(
    breaks = 1:4,
    limits = c(0.4, 4.6),
    labels = paste0(group_order, "\n(n = ", summ$n, ")"),
    expand = c(0, 0)
  ) +
  scale_y_continuous(
    name = expression("MyD88 relative expression (log"[2]*" fold change)"),
    breaks = ticks,
    limits = c(y_min, y_max),
    expand = c(0, 0),
    sec.axis = sec_axis(
      ~ ., name = "Fold change", breaks = ticks,
      labels = function(x) format(2^x, trim = TRUE, scientific = FALSE)
    )
  ) +
  labs(x = NULL) +
  theme_classic(base_size = 9, base_family = "sans") +
  theme(
    axis.text = element_text(colour = "black"),
    axis.line = element_line(linewidth = 0.4),
    axis.ticks = element_line(linewidth = 0.4),
    axis.line.x.top = element_blank()
  )

