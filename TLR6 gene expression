fmt_p <- function(p) {
  if (p < 0.001) "p < 0.001" else sprintf("p = %.3f", p)
}

# Median and IQR on the log2 scale (R default quantile type 7)
summ <- do.call(rbind, lapply(group_order, function(g) {
  y <- d$log2fc[d$group == g]
  q <- quantile(y, c(0.25, 0.5, 0.75))
  data.frame(group = g, xpos = match(g, group_order),
             q1 = q[[1]], med = q[[2]], q3 = q[[3]], n = length(y))
}))

