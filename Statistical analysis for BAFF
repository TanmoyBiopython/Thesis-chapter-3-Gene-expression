# Load required libraries
# install.packages(c("ggplot2", "dplyr", "rstatix", "ggpubr", "dunn.test"))
library(ggplot2)
library(dplyr)
library(rstatix)
library(ggpubr)

# ============================================================
# BAFF Data
# ============================================================
gbs <- c(1.46, 0.70, 1.31, 0.30, 0.41, 2.42, 3.38, 1.74, 2.67, 0.23,
         1.14, 2.74, 0.84, 0.77, 0.51, 0.35, 0.70, 0.85, 0.09, 4.11,
         2.78, 2.59, 1.08)

sle <- c(6.78, 2.10, 0.39, 4.84, 1.82, 1.11, 0.28, 1.28, 1.40, 2.63,
         1.96, 3.56, 1.78, 3.30, 2.01, 1.04, 4.60, 4.99, 6.97, 2.16,
         1.50, 2.13, 1.18)

ms <- c(0.31, 0.82, 1.08, 1.43, 1.58, 1.13, 1.91, 0.82, 1.50, 3.75,
        0.17, 2.31, 2.33, 0.80, 2.09, 0.72, 2.64, 1.19, 0.39, 2.56,
        1.02, 0.50, 0.70)

hc_ddct <- c(-0.43, 1.82, 0.38, 0.57, -0.73, -1.14, -0.83, 0.76, 1.97,
             -0.99, 1.87, -1.80, 0.89, 0.15, 0.32, 0.20, -0.53, -2.39,
             -1.71, -0.30, 0.10, 0.05, 1.78)

# ============================================================
# 1. Descriptive Summary (Fold Change Scale)
# ============================================================
cat("\n--- Descriptive summary — BAFF fold change ---\n")
fc_table <- data.frame(
  Group = c("GBS", "SLE", "MS", "HC QC"),
  n = c(23, 23, 23, 23),
  Mean_FC = c(round(mean(gbs),2), round(mean(sle),2), round(mean(ms),2), "ΔΔCt mean ≈ 0.00"),
  Median_FC = c(round(median(gbs),2), round(median(sle),2), round(median(ms),2), "ΔΔCt median = 0.10"),
  IQR = c("0.70–2.59", "1.40–4.60", "0.72–2.09", "-0.83–0.89"),
  Min = c(round(min(gbs),2), round(min(sle),2), round(min(ms),2), round(min(hc_ddct),2)),
  Max = c(round(max(gbs),2), round(max(sle),2), round(max(ms),2), round(max(hc_ddct),2)),
  SD = c(round(sd(gbs),2), round(sd(sle),2), round(sd(ms),2), round(sd(hc_ddct),2))
)
print(fc_table)

# ============================================================
# 2. Kruskal-Wallis
# ============================================================
# Transform all to log2 scale (HC: log2FC = -ddCt)
values <- c(log2(gbs), log2(sle), log2(ms), -hc_ddct)
group  <- factor(rep(c("GBS", "SLE", "MS", "HC"), each = 23),
                 levels = c("HC", "GBS", "SLE", "MS"))

kw <- kruskal.test(values ~ group)
cat("\n--- Kruskal-Wallis results ---\n")
cat("H =", round(kw$statistic, 2), "\n")
cat("df =", kw$parameter, "\n")
cat("p ≈", format.pval(kw$p.value, digits = 3), "\n")

# ============================================================
# 3. Dunn post-hoc tests (Holm)
# ============================================================
cat("\n--- Dunn post-hoc tests (Holm-adjusted) ---\n")
df <- data.frame(value = values, group = group)
dunn_res <- dunn_test(df, value ~ group, p.adjust.method = "holm")
print(dunn_res)

# ============================================================
# 4. Descriptive Summary on log2 scale
# ============================================================
cat("\n--- 1. Descriptive summary on log2 scale ---\n")
log2_table <- data.frame(
  Group = c("GBS", "SLE", "MS", "HC QC"),
  n = c(23, 23, 23, 23),
  Median_log2_FC = c(round(log2(median(gbs)),2), round(log2(median(sle)),2), round(log2(median(ms)),2), round(-median(hc_ddct),2)),
  IQR_log2_FC = c(
    paste0(round(log2(quantile(gbs, 0.25)),2), " to ", round(log2(quantile(gbs, 0.75)),2)),
    paste0(round(log2(quantile(sle, 0.25)),2), " to ", round(log2(quantile(sle, 0.75)),2)),
    paste0(round(log2(quantile(ms, 0.25)),2), " to ", round(log2(quantile(ms, 0.75)),2)),
    paste0(round(-quantile(hc_ddct, 0.75),2), " to ", round(-quantile(hc_ddct, 0.25),2))
  ),
  Median_FC = c(round(median(gbs),2), round(median(sle),2), round(median(ms),2), round(2^(-median(hc_ddct)),2)),
  IQR_FC = c(
    paste0(round(quantile(gbs, 0.25),2), " to ", round(quantile(gbs, 0.75),2)),
    paste0(round(quantile(sle, 0.25),2), " to ", round(quantile(sle, 0.75),2)),
    paste0(round(quantile(ms, 0.25),2), " to ", round(quantile(ms, 0.75),2)),
    paste0(round(2^(-quantile(hc_ddct, 0.75)),2), " to ", round(2^(-quantile(hc_ddct, 0.25)),2))
  )
)
print(log2_table)

# ============================================================
# 5. Exact Mann-Whitney U (Pairwise)
# ============================================================
exact_mwu <- function(x, y, label) {
  res <- suppressWarnings(wilcox.test(x, y, exact = TRUE, correct = FALSE))
  res_asy <- wilcox.test(x, y, exact = FALSE, correct = TRUE)
  data.frame(
    Comparison = label,
    U = res$statistic,
    p_exact = res$p.value,
    p_asymptotic = res_asy$p.value,
    Method = ifelse(any(duplicated(c(x, y))), "Asymptotic (ties present)", "Exact")
  )
}

cat("\n--- Exact Mann-Whitney U (Pairwise) ---\n")
mwu_res <- rbind(
  exact_mwu(log2(gbs), log2(sle), "GBS vs SLE"),
  exact_mwu(log2(gbs), log2(ms), "GBS vs MS"),
  exact_mwu(log2(gbs), -hc_ddct, "GBS vs HC"),
  exact_mwu(log2(sle), log2(ms), "SLE vs MS"),
  exact_mwu(log2(sle), -hc_ddct, "SLE vs HC"),
  exact_mwu(log2(ms), -hc_ddct, "MS vs HC")
)
mwu_res$p_holm <- p.adjust(mwu_res$p_exact, method = "holm")
print(mwu_res)

# ============================================================
# 6. Plot
# ============================================================
# Get significant Dunn comparisons for plotting
dunn_sig <- dunn_res %>% filter(p.adj < 0.05)
# Manually define y-positions for the 3 significant brackets
dunn_sig$y.position <- c(3.5, 4.2, 4.9) 

p <- ggplot(df, aes(x = group, y = value, fill = group)) +
  geom_boxplot(width = 0.55, outlier.shape = NA, alpha = 0.6, 
               color = "grey20", linewidth = 0.5) +
  geom_jitter(width = 0.15, size = 2.5, alpha = 0.85, 
              shape = 21, color = "black", stroke = 0.4) +
  scale_fill_manual(values = c(HC = "#4C72B0", GBS = "#DD8452", 
                               SLE = "#55A868", MS = "#C44E52")) +
  labs(
    x = NULL,
    y = expression(bold(log[2]~"fold change of BAFF")),
    title = "BAFF expression across study groups",
    subtitle = paste0("Kruskal-Wallis p = ", format.pval(kw$p.value, digits = 3), 
                      "  |  Dunn post-hoc, Holm-adjusted")
  ) +
  theme_classic(base_size = 14) +
  theme(
    legend.position = "none",
    plot.title = element_text(face = "bold", size = 15),
    plot.subtitle = element_text(color = "grey30", size = 11),
    axis.text = element_text(color = "black", size = 12),
    axis.title = element_text(size = 13)
  ) +
  coord_cartesian(ylim = c(min(df$value) - 0.5, max(df$value) + 1.5))

# Add significance brackets
if (nrow(dunn_sig) > 0) {
  p <- p + stat_pvalue_manual(
    dunn_sig,
    label = "p.adj.signif",
    y.position = "y.position",
    tip.length = 0.02,
    size = 5,
    bracket.size = 0.6
  )
}

print(p)
ggsave("BAFF_boxplot.png", p, width = 7, height = 6.5, dpi = 300)
