dunn_holm <- function(x, g) {
  g <- factor(g)
  N <- length(x)
  r <- rank(x)
  mr <- sapply(split(r, g), mean)
  n <- sapply(split(r, g), length)
  tt <- table(x)
  tie <- 1 - sum(tt^3 - tt) / (N^3 - N)
  pr <- combn(levels(g), 2)
  res <- data.frame(a = pr[1, ], b = pr[2, ], stringsAsFactors = FALSE)
  res$z <- (mr[res$a] - mr[res$b]) /
    sqrt(N * (N + 1) / 12 * tie * (1 / n[res$a] + 1 / n[res$b]))
  res$p <- 2 * pnorm(-abs(res$z))
  res$p_holm <- p.adjust(res$p, method = "holm")
  res
}

dunn <- dunn_holm(d$fc, d$group)
print(dunn)

fmt_p <- function(p) if (p < 0.001) "p < 0.001" else sprintf("p = %.3f", p)

summ <- do.call(rbind, lapply(group_order, function(g) {
